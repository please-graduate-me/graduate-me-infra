# 로컬 통합 실행 전용입니다. 실제 값은 Git에 올리지 않습니다.
AUTH_URL=http://localhost:3000
# 비워 두면 localhost와 ADMIN_PORT로 관리자 앱 주소를 구성합니다.
ADMIN_APP_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=
# 기존 로컬 DB를 인계할 때만 graduate-me_postgres_data로 바꿉니다.
LOCAL_POSTGRES_VOLUME=graduate-me-local_postgres_data

# mvp는 작은 자료와 낮은 AI 사용량으로 테스트하며 standard는 기존 운영 한도를 사용합니다.
MATERIAL_POLICY_PROFILE=mvp

# 신규 영상 전사 설정입니다. disabled이면 기존에 준비한 영상만 사용합니다.
VIDEO_TRANSCRIPTION_PROVIDER=disabled
# worker에서만 사용하는 외부 분석 API 설정입니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
YOUTUBE_API_KEY=

# 공급자·모델·키를 함께 선택합니다. 키는 브라우저에 전달하지 않습니다.
AI_PROVIDER=anthropic
OCR_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# API와 worker의 CLOVA 설명·연습·번역 설정입니다.
CLOVA_STUDIO_API_KEY=
CLOVA_TEXT_MODEL=HCX-007
CLOVA_IMAGE_MODEL=HCX-005
CLOVA_STUDIO_BASE_URL=https://clovastudio.stream.ntruss.com

# 계정별 UTC 일일 한도와 동시 실행 수, PDF 최초 준비 최대 페이지 수입니다.
AI_DAILY_REQUEST_LIMIT=30
AI_DAILY_TOKEN_LIMIT=50000
AI_CONCURRENT_REQUEST_LIMIT=1
AI_PREPARATION_PAGE_LIMIT=3

# 0은 추정 비용 제한을 끕니다. 단가를 비우면 비용은 미집계로 표시합니다.
AI_DAILY_BUDGET_USD=0
AI_ANTHROPIC_INPUT_USD_PER_MILLION=
AI_ANTHROPIC_OUTPUT_USD_PER_MILLION=
AI_NAVER_INPUT_USD_PER_MILLION=
AI_NAVER_OUTPUT_USD_PER_MILLION=
AI_GEMINI_INPUT_USD_PER_MILLION=
AI_GEMINI_OUTPUT_USD_PER_MILLION=

# API 서버에서만 사용하는 CLOVA OCR General 도메인과 페이지별 추정 단가입니다.
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET_KEY=
OCR_ESTIMATED_USD_PER_PAGE=

# 로컬 통합 실행 전용입니다. 실제 값은 Git에 올리지 않습니다.
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=
# openssl rand -hex 32로 생성합니다.
PROCESSOR_API_TOKEN=
GROQ_API_KEY=
YOUTUBE_API_KEY=
PROCESSOR_CONCURRENCY=1
# 기존 로컬 DB를 인계할 때만 graduate-me_postgres_data로 바꿉니다.
LOCAL_POSTGRES_VOLUME=graduate-me-local_postgres_data

http://{$PRODUCTION_DOMAIN} {
	@api path /api /api/*
	handle @api {
		reverse_proxy production-api:4000 {
			# 공개 HTTPS는 Cloudflare가 종료하고 Tunnel 내부는 HTTP를 사용한다.
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
		}
	}
	redir /admin https://{$ADMIN_DOMAIN}/ 308
	handle_path /admin/* {
		redir https://{$ADMIN_DOMAIN}{uri} 308
	}
	handle {
		reverse_proxy production-web:3000 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
		}
	}
}

http://{$ADMIN_DOMAIN} {
	@api path /api /api/*
	handle @api {
		reverse_proxy production-api:4000 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
		}
	}
	handle {
		reverse_proxy production-admin:3001 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
		}
	}
}

http://{$DEVELOPMENT_API_DOMAIN} {
	reverse_proxy development-api:4000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
	}
}
